# Backend en localhost:8010 (Kubernetes LoadBalancer o Docker Compose).
# Antes de npm run dev: Docker Desktop + pods K8s + postgres (docker compose up -d users-db pm-db flyway-users flyway-pm).
VITE_API_BASE_URL=/api/v1
VITE_API_PROXY_TARGET=http://localhost:8010

