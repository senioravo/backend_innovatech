# Servidor
PORT=3003
NODE_ENV=development

# Base de Datos
# ⚠️ IMPORTANTE: Debe apuntar a la MISMA base de datos que ms-auth
# porque ambos servicios comparten la tabla 'usuarios'
DATABASE_URL=postgresql://user:password@host:port/database?sslmode=require

# Base de Datos (Opción 2: Local)
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=tu_password
# DB_NAME=innovatech_users

# JWT - Verificación de tokens
# ms-users verifica tokens generados por ms-auth
JWT_PUBLIC_KEY_PATH=./keys/jwt_public.pem

# Logging
LOG_LEVEL=info

# Elasticsearch (opcional para auditoría)
ELASTICSEARCH_NODE=http://localhost:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=changeme

# GlitchTip (opcional — ver backend/GLITCHTIP.md)
# SENTRY_DSN=https://<public-key>@app.glitchtip.com/<project-id>
# SENTRY_ENVIRONMENT=development
