# Variables para docker compose (copiar a .env.docker y completar con tus credenciales)
# cp .env.docker.example .env.docker
# docker compose --env-file .env.docker up --build

DATABASE_URL_AUTH=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
DATABASE_URL_USERS=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
DATABASE_URL_PM=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

USERS_SERVICE_URL=http://users:3003
INTERNAL_SERVICE_TOKEN=development-token-change-in-production

# GlitchTip / Sentry (opcional — sin DSN la observabilidad queda desactivada)
# Obtener en app.glitchtip.com → Proyecto → Settings → Client Keys (DSN)
SENTRY_DSN=https://<public-key>@app.glitchtip.com/<project-id>
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=1.0.0
SENTRY_TRACES_SAMPLE_RATE=0.1
