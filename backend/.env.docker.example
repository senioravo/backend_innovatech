# Project-manager: base de datos del microservicio project-manager
DATABASE_URL_PM=postgresql://neondb_owner:npg_mUZLr81Eslyx@ep-super-tooth-ata043sj-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# URL interna de ms-users (para que ms-auth pueda consultarlo al hacer login)
USERS_SERVICE_URL=http://users:3003

# Token para comunicación interna entre servicios
#
INTERNAL_SERVICE_TOKEN=development-token-change-in-production

# JWT con RSA (RS256):
# ms-auth firma tokens con clave PRIVADA
# BFF y project-manager verifican con clave PÚBLICA
# Ver: setup-keys.bat (Windows) o setup-keys.sh (Linux/Mac)
