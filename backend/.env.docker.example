# Variables para docker compose (copiar a .env.docker)
# docker compose --env-file .env.docker up --build

# Auth: base de datos del microservicio auth
DATABASE_URL_AUTH=postgresql://USER:PASSWORD@host:5432/authdb?sslmode=require

# Project-manager (puede ser la misma instancia Neon con otro schema o misma URL)
DATABASE_URL_PM=postgresql://USER:PASSWORD@host:5432/neondb?sslmode=require

# JWT con RSA (RS256):
# Ya NO se usa JWT_SECRET compartido (inseguro)
# ms-auth firma tokens con clave PRIVADA
# BFF y project-manager verifican con clave PÚBLICA
# Ver: docs/JWT_RSA_MIGRATION.md para más detalles
