PORT=3010
NODE_ENV=development
# Mismo secreto que Auth / Project-manager para validar JWT en el BFF
JWT_SECRET=cambiar_en_produccion
# Prefijo bajo el que se monta el gateway del BFF
API_GATEWAY_PREFIX=/api/v1

# Microservicios (orquestación HTTP desde el BFF)
# Local sin Docker: localhost. Con docker compose (API Gateway en :8080): el BFF usa nombres de servicio:
#   AUTH_SERVICE_BASE_URL=http://auth:3001
#   PROJECT_MANAGER_BASE_URL=http://project-manager:3002
AUTH_SERVICE_BASE_URL=http://localhost:3001
AUTH_API_PREFIX=/api/auth
PROJECT_MANAGER_BASE_URL=http://localhost:3002
PROJECT_MANAGER_API_PREFIX=/api/v1

# GlitchTip (opcional — ver backend/GLITCHTIP.md)
# SENTRY_DSN=https://<public-key>@app.glitchtip.com/<project-id>
# SENTRY_ENVIRONMENT=development
# SENTRY_RELEASE=1.0.0
# SENTRY_TRACES_SAMPLE_RATE=0.1
