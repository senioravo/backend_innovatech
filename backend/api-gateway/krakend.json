{
  "$schema": "https://www.krakend.io/schema/v2.7/krakend.json",
  "version": 3,
  "name": "InnovaTech API Gateway",
  "timeout": "30s",
  "cache_ttl": "300s",
  "output_encoding": "json",
  "port": 8080,
  
  "extra_config": {
    "router": {
      "return_error_msg": true
    },
    "telemetry/logging": {
      "level": "INFO",
      "prefix": "[KRAKEND]",
      "syslog": false,
      "stdout": true
    },
    "security/cors": {
      "allow_origins": ["*"],
      "allow_methods": ["GET", "POST", "PUT", "DELETE", "PATCH", "OPTIONS"],
      "allow_headers": ["Origin", "Authorization", "Content-Type"],
      "expose_headers": ["Content-Length"],
      "max_age": "12h"
    }
  },
  
  "endpoints": [
    {
      "@comment": "Auth: Login público (sin validación JWT)",
      "endpoint": "/api/v1/auth/login",
      "method": "POST",
      "output_encoding": "json",
      "backend": [
        {
          "url_pattern": "/api/v1/auth/login",
          "encoding": "json",
          "method": "POST",
          "host": ["http://bff:3010"],
          "extra_config": {
            "backend/http": {
              "return_error_code": true
            }
          }
        }
      ]
    },
    {
      "@comment": "Auth: Register público (sin validación JWT)",
      "endpoint": "/api/v1/auth/register",
      "method": "POST",
      "output_encoding": "json",
      "backend": [
        {
          "url_pattern": "/api/v1/auth/register",
          "encoding": "json",
          "method": "POST",
          "host": ["http://bff:3010"],
          "extra_config": {
            "backend/http": {
              "return_error_code": true
            }
          }
        }
      ]
    },
    {
      "@comment": "Proyectos: Listar (requiere JWT)",
      "endpoint": "/api/v1/projects",
      "method": "GET",
      "output_encoding": "json",
      "input_headers": ["Authorization", "Content-Type"],
      "extra_config": {
        "auth/validator": {
          "alg": "RS256",
          "jwk_url": "http://auth:3001/.well-known/jwks.json",
          "cache": true,
          "cache_duration": 300,
          "disable_jwk_security": true,
          "issuer": "innovatech-auth",
          "key_identify_strategy": "kid",
          "propagate_claims": [
            ["id", "x-user-id"],
            ["email", "x-user-email"],
            ["role", "x-user-role"]
          ]
        }
      },
      "backend": [
        {
          "url_pattern": "/api/v1/projects",
          "encoding": "json",
          "method": "GET",
          "host": ["http://bff:3010"]
        }
      ]
    },
    {
      "@comment": "Proyectos: Crear (requiere JWT + rol gestor)",
      "endpoint": "/api/v1/projects",
      "method": "POST",
      "output_encoding": "json",
