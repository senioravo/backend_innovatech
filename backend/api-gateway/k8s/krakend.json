            ["id", "x-user-id"],
            ["email", "x-user-email"],
            ["role", "x-user-role"]
          ],
          "roles_key": "role",
          "roles": ["gestor", "directivo"]
        }
      },
      "backend": [
        {
          "url_pattern": "/api/v1/projects",
          "encoding": "json",
