    },
    {
      "@comment": "Proyectos: Listar (requiere JWT)",
      "endpoint": "/api/v1/projects",
      "method": "GET",
      "output_encoding": "json",
      "input_headers": ["Authorization", "Content-Type"],
      "extra_config": {
        "auth/validator": {
          "alg": "RS256",
          "jwk_url": "http://ms-auth:3001/.well-known/jwks.json",
          "cache": true,
          "cache_duration": 300,
          "disable_jwk_security": true,
          "issuer": "innovatech-auth",
          "key_identify_strategy": "kid",
          "propagate_claims": [
            ["id", "x-user-id"],
            ["email", "x-user-email"],
            ["role", "x-user-role"]
          ]
        }
      },
      "backend": [
        {
          "url_pattern": "/api/v1/projects",
          "encoding": "json",
          "method": "GET",
          "host": ["http://bff:3010"]
        }
      ]
    },
    {
      "@comment": "Proyectos: Crear (requiere JWT + rol gestor)",
