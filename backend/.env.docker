# Variables para docker compose (copiar a .env.docker)
# docker compose --env-file .env.docker up --build

# Auth: base de datos del microservicio auth
DATABASE_URL_AUTH=postgresql://neondb_owner:npg_mUZLr81Eslyx@ep-super-tooth-ata043sj-pooler.c-9.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Project-manager: su propia base de datos independiente
DATABASE_URL_PM=postgresql://neondb_owner:npg_mUZLr81Eslyx@ep-super-tooth-ata043sj-pooler.c-9.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Users: BASE DE DATOS SEPARADA siguiendo patrón Database per Service
# Cada microservicio tiene su propia base de datos para mantener independencia y escalabilidad
# ⚠️ IMPORTANTE: Crear una base de datos diferente para ms-users en producción
DATABASE_URL_USERS=postgresql://neondb_owner:npg_mUZLr81Eslyx@ep-super-tooth-ata043sj-pooler.c-9.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Comunicación entre microservicios
# URL del microservicio de usuarios (para que ms-auth pueda consultar usuarios)
USERS_SERVICE_URL=http://users:3003

# Token de seguridad para comunicación interna entre servicios
# ⚠️ CAMBIAR EN PRODUCCIÓN - Usar un token seguro y aleatorio
INTERNAL_SERVICE_TOKEN=development-token-change-in-production

# JWT con RSA (RS256):
# Ya NO se usa JWT_SECRET compartido (inseguro)
# ms-auth firma tokens con clave PRIVADA
# BFF y project-manager verifican con clave PÚBLICA
# Ver: docs/JWT_RSA_MIGRATION.md
