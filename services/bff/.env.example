PORT=3010
NODE_ENV=development
# Prefijo bajo el que se monta el gateway del BFF
API_GATEWAY_PREFIX=/api/v1

# Microservicios (orquestación HTTP directa; sin API Gateway corporativo aún)
AUTH_SERVICE_BASE_URL=http://localhost:3001
AUTH_API_PREFIX=/api/auth
PROJECT_MANAGER_BASE_URL=http://localhost:3002
PROJECT_MANAGER_API_PREFIX=/api/v1
