PORT=3002
JWT_SECRET=cambiar_en_produccion
NODE_ENV=development
# Prefijo del API Gateway (rutas de negocio bajo este path)
API_GATEWAY_PREFIX=/api/v1

# Llamadas internas (opcional): health de Auth vía circuit breaker
# AUTH_SERVICE_URL=http://localhost:3001
INTERNAL_REQUEST_TIMEOUT_MS=5000
CB_FAILURE_THRESHOLD=5
CB_RESET_TIMEOUT_MS=30000
CB_SUCCESS_THRESHOLD=1
