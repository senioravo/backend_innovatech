PORT=3002
JWT_SECRET=cambiar_en_produccion
NODE_ENV=development
# Prefijo del API Gateway (rutas de negocio bajo este path)
API_GATEWAY_PREFIX=/api/v1

# PostgreSQL (Neon). No subas este archivo con secretos reales al repositorio.
# Ejemplo: postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
DATABASE_URL=

# Llamadas internas (opcional): health de Auth vía circuit breaker
# AUTH_SERVICE_URL=http://localhost:3001
INTERNAL_REQUEST_TIMEOUT_MS=5000
CB_FAILURE_THRESHOLD=5
CB_RESET_TIMEOUT_MS=30000
CB_SUCCESS_THRESHOLD=1

# Elasticsearch — auditoría centralizada (opcional). Sin ELASTICSEARCH_NODE solo hay logs en consola.
# ELASTICSEARCH_NODE=https://mi-cluster.es.region.cloud.es.io:443
# ELASTICSEARCH_AUDIT_INDEX=project-manager-audit
# Autenticación: API key (recomendado en Elastic Cloud) o usuario/contraseña
# ELASTICSEARCH_API_KEY=base64ApiKeyHere==
# ELASTICSEARCH_USERNAME=elastic
# ELASTICSEARCH_PASSWORD=
# Solo desarrollo / cert autofirmado: ELASTICSEARCH_TLS_INSECURE=1
