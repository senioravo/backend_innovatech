# AS-TASK-04: PostgreSQL Database Configuration
PORT=3001

# AS-TASK-06: JWT Configuration (Validación y generación segura)
JWT_SECRET=your_secret_key_here_change_in_production
JWT_EXPIRES_IN=1h
JWT_ISSUER=innovatech-auth

# AS-TASK-19: PostgreSQL Connection - Opción 1 (Neon, Heroku, Railway)
# DATABASE_URL=postgresql://user:password@host:port/database?sslmode=require

# AS-TASK-19: PostgreSQL Connection - Opción 2 (Local o variables separadas)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=innovatech_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password

# AS-TASK-17: Bcrypt Configuration
BCRYPT_SALT_ROUNDS=10

# AS-TASK-03: Circuit Breaker Configuration
CIRCUIT_BREAKER_TIMEOUT=3000
CIRCUIT_BREAKER_ERROR_THRESHOLD=50
CIRCUIT_BREAKER_RESET_TIMEOUT=30000
